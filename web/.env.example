# Shuffle Admin Web App — Configuration
# Copy to .env and customize

SHUFFLE_WEB_SECRET_KEY=change-me-to-a-random-64-char-string
SHUFFLE_WEB_ADMIN_USER=admin
SHUFFLE_WEB_ADMIN_PASS=changeme123
SHUFFLE_WEB_HOST=127.0.0.1
SHUFFLE_WEB_PORT=8002
SHUFFLE_WEB_DEBUG=false

# Paths (defaults usually work)
# SHUFFLE_WEB_DB_PATH=~/.shuffle_web.db
# SHUFFLE_WEB_BOT_DATA_DIR=~/.shufflebot_tg
# SHUFFLE_WEB_INSTALL_DIR=~/shuffle-bot
# SHUFFLE_WEB_REPO_DIR=~/shuffle

# Service names
# SHUFFLE_WEB_SERVICE_CLI=shuffle
# SHUFFLE_WEB_SERVICE_TG=shuffle-tg
# SHUFFLE_WEB_SERVICE_WEB=shuffle-web

# Telegram (optional — for generating auth deep links)
# SHUFFLE_WEB_TG_BOT_TOKEN=
