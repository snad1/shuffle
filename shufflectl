# Hard statistics reset. ARCHIVES the DB (mv, never deletes) so a fresh
# statistics flow can begin while the config stays untouched. The daemon is
# stopped if running; stale live state is cleared so --resume doesn't bring
# the old session number into the fresh DB.
cmd_reset() {
    local yes=0
    for arg in "$@"; do
        case "$arg" in
            --yes|-y) yes=1 ;;
        esac
    done
    if [ ! -f "$DB" ]; then
        echo "No DB found at $DB - nothing to reset."
        return
    fi
    local sess bets size
    sess=$(sqlite3 "$DB" "SELECT COUNT(*) FROM sessions" 2>/dev/null || echo "?")
    bets=$(sqlite3 "$DB" "SELECT COALESCE(SUM(total_bets),0) FROM sessions" 2>/dev/null || echo "?")
    size=$(du -h "$DB" | awk '{print $1}')
    local was_running=0
    if systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; then
        was_running=1
    fi
    if [ "$yes" = "0" ]; then
        echo "This will ARCHIVE (not delete) your statistics and start fresh:"
        echo "  sessions: $sess   bets: $bets   db size: $size"
        echo "  archive  -> ~/.shuffle_autobot-<timestamp>.db"
        echo "  config   -> untouched (~/.shuffle_autobot.json)"
        [ "$was_running" = "1" ] && echo "  daemon   -> will be stopped (not restarted)"
        local reply=""
        read -r -p "Proceed? [y/N] " reply || true
        case "$reply" in
            y|Y|yes|YES) ;;
            *) echo "Aborted."; return ;;
        esac
    fi
    if [ "$was_running" = "1" ]; then
        stop_all_lanes
        systemctl --user stop "$SERVICE"
        echo "Daemon stopped."
    fi
    local ts archive
    ts=$(date +%Y%m%d-%H%M%S)
    archive="$HOME/.shuffle_autobot-$ts.db"
    mv "$DB" "$archive"
    # The write-ahead log belongs to the archived file; left behind, SQLite would read it
    # as part of the new, empty database.
    local part
    for part in wal shm; do
        if [ -e "$DB-$part" ]; then mv "$DB-$part" "$archive-$part"; fi
    done
    # A session-end request points at a session the new statistics don't have.
    rm -f "$HOME/.shuffle_autobot.drain" "$HOME"/.shuffle_autobot.lane*.drain
    rm -f "$HOME/.shuffle_autobot_live.json" "$HOME"/.shuffle_autobot_live.lane*.json
    # Session ids restart at 1, so the run-wide profit total starts over too.
    rm -f "$HOME/.shuffle_run.json" "$HOME"/.shuffle_run.lane*.json
    echo "Archived -> $archive  ($sess sessions, $bets bets, $size)"
    echo "Config untouched. Next 'shufflectl start' begins fresh statistics."
    echo "Revisit anytime: shufflectl archives"
}

# Start a new run total for the run-wide profit increment.
cmd_run_reset() {
    local yes=0 was_running=0
    for arg in "$@"; do
        case "$arg" in --yes|-y) yes=1 ;; esac
    done
    systemctl --user is-active --quiet "$SERVICE" 2>/dev/null && was_running=1
    if [ "$yes" = "0" ]; then
        echo "This starts a new run total for profit_increment_scope=run:"
        echo "  run profit -> back to 0 from the next session"
        echo "  base_bet   -> back to the config value (run bumps dropped)"
        echo "  statistics -> untouched"
        [ "$was_running" = "1" ] && echo "  lanes      -> restarted (each running chain is saved and ended)"
        local reply=""
        read -r -p "Proceed? [y/N] " reply || true
        case "$reply" in
            y|Y|yes|YES) ;;
            *) echo "Aborted."; return ;;
        esac
    fi
    if [ "$was_running" = "1" ]; then
        stop_all_lanes
        systemctl --user stop "$SERVICE"
    fi
    "$PYTHON" "$BOT" --run-reset
    if [ "$was_running" = "1" ]; then
        systemctl --user start "$SERVICE"
        sync_lanes
        echo "Lanes restarted on a new run."
    fi
}

# List archived statistics DBs with session counts + date spans.
cmd_archives() {
    local found=0 total_bytes=0
    for f in "$HOME"/.shuffle_autobot-*.db; do
        [ -f "$f" ] || continue
        found=1
        local sess span size bytes
        sess=$(sqlite3 "$f" "SELECT COUNT(*) FROM sessions" 2>/dev/null || echo "?")
        span=$(sqlite3 "$f" "SELECT COALESCE(MIN(started_at),'?') || ' -> ' || COALESCE(MAX(started_at),'?') FROM sessions" 2>/dev/null || echo "?")
        size=$(du -h "$f" | awk '{print $1}')
        bytes=$(wc -c < "$f" | tr -d ' ')
        total_bytes=$(( total_bytes + bytes ))
        printf "  %s  %s sessions  %s  %s\n" "$(basename "$f")" "$sess" "$span" "$size"
    done
    if [ "$found" = "0" ]; then
        echo "No archives found (~/.shuffle_autobot-*.db)."
        echo "Create one with: shufflectl reset"
        return
    fi
    echo ""
    echo "  Total: $(echo "$total_bytes" | awk '{printf "%.1f MB", $1/1024/1024}')"
    echo "  Query any archive directly: sqlite3 <archive> 'SELECT ... FROM sessions'"
}

# SHUFFLECTL_VERSION of a shufflectl file ("" when unreadable).
_ctl_version_of() {
    grep -m1 '^SHUFFLECTL_VERSION=' "$1" 2>/dev/null | cut -d= -f2 || true
}

_file_mode() {
    stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1" 2>/dev/null || echo "?"
}

# Health check. Read-only by default; --fix applies the safe fixes only
# (boot-enable the CLI unit, config mode 0600, bet-row cleanup, VACUUM,
# journal vacuum). Privileged fixes are prescribed, never applied. On
# virtualized hosts the CPU governor advice is [SKIP]: guests can't change it.
cmd_doctor() {
    local do_fix=0 do_yes=0
    for arg in "$@"; do
        case "$arg" in
            --fix)     do_fix=1 ;;
            --yes|-y)  do_yes=1 ;;
        esac
    done
    local fix_enable=0 fix_perms=0 do_vacuum=0 do_journal=0

    echo "--- shufflectl doctor ---"
    echo ""
    echo "1. Install:"
    if [ -f "$SYSTEMD_DIR/${SERVICE}.service" ]; then
        echo "  [OK]    unit file ${SERVICE}.service"
    else
        echo "  [WARN]  unit file ${SERVICE}.service missing - rerun install.sh"
    fi
    if systemctl --user is-enabled --quiet "$SERVICE" 2>/dev/null; then
        echo "  [OK]    ${SERVICE}.service enabled (starts on boot)"
    else
        echo "  [WARN]  ${SERVICE}.service is not enabled: a reboot leaves the bot down"
        echo "          fix: systemctl --user enable ${SERVICE}"
        fix_enable=1
    fi
    if [ -x "$PYTHON" ]; then
        echo "  [OK]    venv python $PYTHON"
        if "$PYTHON" -c "import shared" >/dev/null 2>&1; then
            echo "  [OK]    casino-shared importable"
        else
            echo "  [WARN]  casino-shared does not import - run: shufflectl update"
        fi
    else
        echo "  [WARN]  venv python missing at $PYTHON - rerun install.sh"
    fi
    if [ -f "$CONFIG" ]; then
        local mode
        mode=$(_file_mode "$CONFIG")
        if [ "$mode" = "600" ]; then
            echo "  [OK]    config mode 600"
        else
            echo "  [WARN]  config mode $mode (holds credentials, should be 600)"
            echo "          fix: chmod 600 $CONFIG"
            fix_perms=1
        fi
    else
        echo "  [WARN]  no config at $CONFIG - run: shufflectl setup"
    fi
    if [ -f "$SCRIPT_NAME" ] && [ "$(_ctl_version_of "$SCRIPT_NAME")" != "$SHUFFLECTL_VERSION" ]; then
        echo "  [WARN]  shufflectl $SHUFFLECTL_VERSION is older than the repo copy ($(_ctl_version_of "$SCRIPT_NAME")) - run: shufflectl refresh"
    fi

    echo ""
    echo "2. Live diagnostic (shufflectl diagnose):"
    "$PYTHON" "$BOT" --diagnose 2>/dev/null || echo "  (daemon not running - start with 'shufflectl start')"

    echo ""
    echo "3. Database:"
    local frag_pct=0
    if [ -f "$DB" ]; then
        local db_size page_count freelist integrity
        db_size=$(du -h "$DB" 2>/dev/null | awk '{print $1}')
        page_count=$(sqlite3 "$DB" "PRAGMA page_count" 2>/dev/null || echo 0)
        freelist=$(sqlite3 "$DB" "PRAGMA freelist_count" 2>/dev/null || echo 0)
        if [ "$page_count" -gt 0 ] 2>/dev/null; then
            frag_pct=$(( freelist * 100 / page_count ))
        fi
        echo "  DB: $DB  size=$db_size  fragmentation=${frag_pct}% (freelist=$freelist / pages=$page_count)"
        integrity=$(sqlite3 "$DB" "PRAGMA integrity_check" 2>/dev/null | head -1 || true)
        if [ "$integrity" = "ok" ]; then
            echo "  [OK]    integrity_check ok"
        elif [ -n "$integrity" ]; then
            echo "  [WARN]  integrity_check: $integrity - archive with: shufflectl reset"
        else
            echo "  [SKIP]  integrity_check (sqlite3 not installed)"
        fi
    else
        echo "  DB: $DB not found (daemon has never run?)"
    fi

    echo ""
    echo "4. Journal size (${SERVICE}.service):"
    journalctl --user -u "$SERVICE" --disk-usage 2>/dev/null | sed 's/^/  /' \
        || echo "  (not managed by systemd)"

    echo ""
    echo "5. System resources:"
    echo "  Load: $(uptime | awk -F'load average[s]*: ' '{print $2}')"
    echo "  Disk on \$HOME:"
    df -h "$HOME" | tail -1 | sed 's/^/    /'
    local avail_pct
    avail_pct=$(df -P "$HOME" | awk 'NR==2 {gsub("%","",$5); print 100-$5}')
    if [ -n "$avail_pct" ] && [ "$avail_pct" -lt 10 ] 2>/dev/null; then
        echo "  [WARN]  only ${avail_pct}% disk free - run: shufflectl cleanup 1"
    fi

    echo ""
    echo "6. Daemon priority:"
    local pid nice_val
    pid=$(pgrep -f 'shuffle\.py.*--daemon' 2>/dev/null | head -1 || true)
    if [ -n "$pid" ]; then
        nice_val=$(ps -o ni= -p "$pid" 2>/dev/null | tr -d ' ')
        echo "  PID $pid  nice=${nice_val:-?}"
    else
        echo "  (daemon not running)"
    fi

    echo ""
    echo "--- Prescriptions ---"
    if [ "$frag_pct" -ge 20 ] 2>/dev/null; then
        echo "  [SAFE]  SQLite VACUUM (fragmentation ${frag_pct}% >= 20%):"
        echo "          sqlite3 $DB 'VACUUM;'"
        do_vacuum=1
    fi
    echo "  [SAFE]  Force bet-row retention now:"
    echo "          shufflectl cleanup 1"
    local jsz
    jsz=$(journalctl --user -u "$SERVICE" --disk-usage 2>/dev/null | grep -oE '[0-9.]+[KMG]' | head -1 || true)
    if [ -n "$jsz" ] && echo "$jsz" | grep -qE '[0-9]+G|[5-9][0-9][0-9]M'; then
        echo "  [SAFE]  Journal is large ($jsz) - vacuum to 100 M:"
        echo "          journalctl --user --vacuum-size=100M"
        do_journal=1
    fi
    if [ -n "$pid" ] && [ -n "${nice_val:-}" ] && [ "$nice_val" -gt -5 ] 2>/dev/null; then
        echo "  [PRIV]  Raise daemon scheduling priority (needs sudo):"
        echo "          sudo renice -n -5 -p $pid"
        echo "          sudo ionice -c 2 -n 0 -p $pid"
    fi
    local virt="" gov
    if command -v systemd-detect-virt >/dev/null 2>&1; then
        virt=$(systemd-detect-virt 2>/dev/null || echo "")
    fi
    gov=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || true)
    if [ -n "$gov" ] && [ "$gov" != "performance" ]; then
        if [ -n "$virt" ] && [ "$virt" != "none" ]; then
            echo "  [SKIP]  CPU governor is '$gov' but this host is virtualized ($virt):"
            echo "          guests cannot set the governor."
        else
            echo "  [PRIV]  Pin CPU governor to performance (needs sudo):"
            echo "          sudo cpupower frequency-set -g performance"
        fi
    elif [ -z "$gov" ] && [ -n "$virt" ] && [ "$virt" != "none" ]; then
        echo "  [SKIP]  CPU governor not exposed on this virtualized host ($virt)."
    fi

    if [ "$do_fix" = "1" ]; then
        echo ""
        echo "--- Applying safe fixes (--fix) ---"
        _doctor_run_fix() {
            local desc="$1" reply=""
            shift
            if [ "$do_yes" = "0" ]; then
                read -r -p "  $desc - apply? [y/N] " reply || true
                case "$reply" in
                    y|Y|yes|YES) ;;
                    *) echo "    skipped."; return ;;
                esac
            fi
            echo "  \$ $*"
            "$@" || echo "    failed."
        }
        if [ "$fix_enable" = "1" ]; then
            _doctor_run_fix "Enable ${SERVICE}.service on boot" systemctl --user enable "$SERVICE"
        fi
        if [ "$fix_perms" = "1" ]; then
            _doctor_run_fix "Set the config to mode 600" chmod 600 "$CONFIG"
        fi
        _doctor_run_fix "Force bet-row retention (age > 1 day)" "$PYTHON" "$BOT" --cleanup 1
        if [ "$do_vacuum" = "1" ]; then
            _doctor_run_fix "SQLite VACUUM (reclaim fragmented pages)" sqlite3 "$DB" "VACUUM;"
        fi
        if [ "$do_journal" = "1" ]; then
            _doctor_run_fix "Journal vacuum to 100 M" journalctl --user --vacuum-size=100M
        fi
        echo ""
        echo "Done. Run 'shufflectl diagnose' again in 5 minutes to see the delta."
    else
        echo ""
        echo "To apply the safe fixes, run: shufflectl doctor --fix   (add --yes to skip each prompt)"
    fi
}

# Copy the repo's shufflectl (this folder) over the installed one.
_install_ctl() {
    local installed="$1"
    install -m 0755 "$SCRIPT_NAME" "$installed"
}

# Reinstall shufflectl from the repo copy in the current folder. No pull, no
# pip install, no restart.
cmd_refresh() {
    if [ ! -f "$SCRIPT_NAME" ]; then
        echo "No $SCRIPT_NAME in the current folder: run this from the shuffle repo."
        exit 1
    fi
    local installed repo_ver
    installed="$(command -v "$SCRIPT_NAME" 2>/dev/null || echo "$HOME/.local/bin/$SCRIPT_NAME")"
    repo_ver="$(_ctl_version_of "$SCRIPT_NAME")"
    if [ -f "$installed" ] && cmp -s "$SCRIPT_NAME" "$installed"; then
        echo "shufflectl already current ($repo_ver) at $installed"
        return
    fi
    mkdir -p "$(dirname "$installed")"
    _install_ctl "$installed"
    echo "shufflectl $SHUFFLECTL_VERSION -> ${repo_ver:-unknown} installed at $installed"
}

# Ask every running lane to restart on the new code when its own session ends.
roll_lanes() {
    local k
    for k in $(lane_ids); do
        systemctl --user is-active --quiet "$(lane_unit "$k")" 2>/dev/null || continue
        if "$PYTHON" "$BOT" --lane-drain "$k" restart >/dev/null; then
            echo "Lane $k restarts on the new code when its session ends."
        else
            echo "Lane $k: could not ask for a restart; it stays on the old code until restarted." >&2
        fi
    done
    echo "Betting goes on; use shufflectl update --critical to restart every lane now."
}

cmd_update() {
    local critical=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --critical) critical=1; shift ;;
            *) echo "Usage: shufflectl update [--critical]" >&2; exit 2 ;;
        esac
    done
    if git rev-parse --is-inside-work-tree &>/dev/null; then
        echo "Pulling latest from git..."
        if ! git diff --quiet || ! git diff --cached --quiet; then
            echo "Local changes detected - autostashing before pull:"
            git status --porcelain
        fi
        # --autostash stashes local changes, pulls, then pops them back.
        # A pop conflict leaves the stash in place for manual recovery.
        if ! git pull --ff-only --autostash; then
            echo "Git pull failed. Resolve manually."
            echo "  If you had local changes, they were stashed."
            echo "  Recover with: git stash list  |  git stash pop"
            exit 1
        fi
    fi
    if [ ! -f "shuffle.py" ]; then
        echo "No shuffle.py in current directory."
        exit 1
    fi

    cp shuffle.py "$INSTALL_DIR/shuffle.py"
    cp requirements.txt "$INSTALL_DIR/" 2>/dev/null
    [ -f ".env.example" ] && cp .env.example "$INSTALL_DIR/"

    if [ -d "core" ]; then
        mkdir -p "$INSTALL_DIR/core"
        cp core/*.py "$INSTALL_DIR/core/"
    fi
    if [ -d "tg" ]; then
        mkdir -p "$INSTALL_DIR/tg"
        cp tg/*.py "$INSTALL_DIR/tg/"
    fi

    # Install the pinned requirements, casino-shared included
    if [ -f "$INSTALL_DIR/venv/bin/pip" ] && [ -f "$INSTALL_DIR/requirements.txt" ]; then
        if "$INSTALL_DIR/venv/bin/pip" install --quiet --upgrade -r "$INSTALL_DIR/requirements.txt"; then
            echo "Requirements installed (pinned casino-shared)."
        else
            echo "✗ Requirements install failed; stopping before the restart." >&2
            exit 1
        fi
    fi

    # Self-update, and say when the shufflectl that is running is older than
    # the repo copy: the old one runs this update to the end, so the operator
    # reruns it once to get the new commands.
    if [ -f "$SCRIPT_NAME" ]; then
        local installed repo_ver
        installed="$(command -v "$SCRIPT_NAME" 2>/dev/null || true)"
        if [ -n "$installed" ] && [ -f "$installed" ]; then
            _install_ctl "$installed"
            echo "Updated $SCRIPT_NAME -> $installed"
        fi
        repo_ver="$(_ctl_version_of "$SCRIPT_NAME")"
        if [ -n "$repo_ver" ] && [ "$repo_ver" != "$SHUFFLECTL_VERSION" ]; then
            echo ""
            echo "  shufflectl was stale: $SHUFFLECTL_VERSION -> $repo_ver"
            echo "     Re-run once to use the new commands:  exec shufflectl update"
            echo ""
        fi
    fi

    # Restart=always respawns a stopped bot; on-failure keeps a stop stopped.
    # The CLI unit also gets Nice=-5 + IO priority. Both edits are idempotent.
    local _sd_reload=0 _unit _unit_path
    for _unit in "${SERVICE}.service" "${TG_SERVICE}.service" "${WEB_SERVICE}.service" "${LANE_SERVICE}@.service"; do
        _unit_path="$SYSTEMD_DIR/$_unit"
        [ -f "$_unit_path" ] || continue
        if grep -q '^Restart=always$' "$_unit_path"; then
            sed -i.bak 's/^Restart=always$/Restart=on-failure/' "$_unit_path" \
                && rm -f "$_unit_path.bak" \
                && echo "Migrated $_unit: Restart=always -> Restart=on-failure" \
                && _sd_reload=1
        fi
        if [ "$_unit" = "${SERVICE}.service" ] && ! grep -q '^Nice=' "$_unit_path"; then
            sed -i.bak '/^\[Service\]$/a Nice=-5\nIOSchedulingClass=best-effort\nIOSchedulingPriority=0' "$_unit_path" \
                && rm -f "$_unit_path.bak" \
                && echo "Added Nice=-5 + IO priority to $_unit" \
                && _sd_reload=1
        fi
    done
    if [ "$_sd_reload" = "1" ]; then
        systemctl --user daemon-reload 2>/dev/null || true
    fi

    # Update web app if installed
    if [ -d "$WEB_DIR" ] && [ -d "web" ]; then
        mkdir -p "$WEB_DIR/web"
        cp -r web/* "$WEB_DIR/web/" 2>/dev/null || true
        [ -f "web/requirements.txt" ] && cp web/requirements.txt "$WEB_DIR/requirements.txt"
        "$WEB_DIR/venv/bin/pip" install --quiet -r "$WEB_DIR/requirements.txt" 2>/dev/null || true
        if systemctl --user is-active --quiet "$WEB_SERVICE" 2>/dev/null; then
            systemctl --user restart "$WEB_SERVICE"
            echo "Web admin updated + restarted."
        fi
    fi

    # Auto-restart TG bot if running
    if systemctl --user is-active --quiet "$TG_SERVICE" 2>/dev/null; then
        systemctl --user restart "$TG_SERVICE"
        sleep 1
        if systemctl --user is-active --quiet "$TG_SERVICE"; then
            echo "Updated + Telegram bot restarted."
        else
            echo "Updated but TG restart failed. Check: shufflectl tg logs"
        fi
    else
        echo "Updated. TG bot not running (skipped restart)."
    fi

    # Each lane restarts on the new shuffle.py at its own session end; --critical restarts
    # every lane now (--resume keeps the session).
    if systemctl --user is-active --quiet "$SERVICE" 2>/dev/null && [ "$critical" = "0" ]; then
        roll_lanes
    elif systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; then
        stop_all_lanes
        systemctl --user restart "$SERVICE"
        sleep 1
        sync_lanes
        if systemctl --user is-active --quiet "$SERVICE"; then
            echo "CLI daemon restarted (session auto-resumed)."
        else
            echo "CLI restart failed. Check: shufflectl logs-full"
        fi
    else
        echo "  CLI bot not running: shufflectl start"
    fi
}

cmd_tg() {
    local action="${1:-}"
    case "$action" in
        setup)
            echo "Enter your Telegram bot token (from @BotFather):"
            read -r token
            if [ -z "$token" ]; then
                echo "No token provided."
                exit 1
            fi
            echo "SHUFFLE_TG_TOKEN=$token" > "$TG_ENV"
            chmod 600 "$TG_ENV"
            echo "Token saved to $TG_ENV"
            echo "Start with: shufflectl tg start"
            ;;
        start)
            if [ ! -f "$TG_ENV" ]; then
                echo "No TG token configured. Run 'shufflectl tg setup' first."
                exit 1
            fi
            systemctl --user start "$TG_SERVICE"
            sleep 1
            if systemctl --user is-active --quiet "$TG_SERVICE"; then
                echo "Telegram bot started."
                echo "  Check status:  shufflectl tg status"
                echo "  View logs:     shufflectl tg logs"
            else
                echo "Failed to start. Check logs: shufflectl tg logs-full"
                exit 1
            fi
            ;;
        stop)
            systemctl --user stop "$TG_SERVICE"
            echo "Telegram bot stopped."
            ;;
        restart)
            systemctl --user restart "$TG_SERVICE"
            sleep 1
            if systemctl --user is-active --quiet "$TG_SERVICE"; then
                echo "Telegram bot restarted."
            else
                echo "Failed to restart. Check: shufflectl tg logs-full"
            fi
            ;;
        status)
            echo ""
            echo "── Telegram Bot Status ──"
            systemctl --user status "$TG_SERVICE" --no-pager 2>/dev/null || echo "  Service not running"
            ;;
        logs)
            journalctl --user -u "$TG_SERVICE" -f --no-pager
            ;;
        logs-full)
            journalctl --user -u "$TG_SERVICE" -n 200 --no-pager
            ;;
        env)
            ENV_FILE="$INSTALL_DIR/.env"
            if [ ! -f "$ENV_FILE" ]; then
                if [ -f "$INSTALL_DIR/.env.example" ]; then
                    cp "$INSTALL_DIR/.env.example" "$ENV_FILE"
                else
                    echo "# Shuffle AutoBot: Environment" > "$ENV_FILE"
                    echo "SHUFFLE_TG_TOKEN=" >> "$ENV_FILE"
                fi
            fi
            ${EDITOR:-nano} "$ENV_FILE"
            TOKEN=$(grep -E "^SHUFFLE_TG_TOKEN=" "$ENV_FILE" | cut -d= -f2- | tr -d ' ')
            if [ -n "$TOKEN" ]; then
                echo "SHUFFLE_TG_TOKEN=$TOKEN" > "$TG_ENV"
                chmod 600 "$TG_ENV"
                echo "Token synced to $TG_ENV"
            fi
            ;;
        *)
            echo "Usage: shufflectl tg [setup|start|stop|restart|status|logs|logs-full|env]"
            ;;
    esac
}

cmd_start_all() {
    echo "Starting all services..."
    cmd_start 2>/dev/null || true
    cmd_tg start 2>/dev/null || true
    if systemctl --user list-unit-files "$WEB_SERVICE.service" &>/dev/null; then
        systemctl --user start "$WEB_SERVICE" 2>/dev/null || true
    fi
    echo ""
    cmd_status_all
}

cmd_stop_all() {
    echo "Stopping all services..."
    stop_all_lanes
    systemctl --user stop "$SERVICE" 2>/dev/null || true
    systemctl --user stop "$TG_SERVICE" 2>/dev/null || true
    systemctl --user stop "$WEB_SERVICE" 2>/dev/null || true
    echo "All services stopped."
}

cmd_status_all() {
    echo ""
    echo "╔══════════════════════════════════════════╗"
    echo "║   Shuffle AutoBot: Service Status        ║"
    echo "╚══════════════════════════════════════════╝"
    echo ""

    if systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; then
        echo "  CLI Bot:      ● RUNNING"
    else
        echo "  CLI Bot:      ○ stopped"
    fi

    if systemctl --user is-active --quiet "$TG_SERVICE" 2>/dev/null; then
        echo "  Telegram Bot: ● RUNNING"
    else
        echo "  Telegram Bot: ○ stopped"
    fi

    if systemctl --user is-active --quiet "$WEB_SERVICE" 2>/dev/null; then
        echo "  Web Admin:    ● RUNNING"
    else
        echo "  Web Admin:    ○ stopped"
    fi

    echo ""
}

cmd_web() {
    local action="${1:-status}"
    case "$action" in
        install)
            if [ -f "web/install.sh" ]; then
                bash web/install.sh --repo "$(pwd)" "${@:2}"
            else
                echo "web/install.sh not found. Run from the repo directory."
                exit 1
            fi
            ;;
        start)
            systemctl --user start "$WEB_SERVICE"
            sleep 1
            if systemctl --user is-active --quiet "$WEB_SERVICE"; then
                echo "Web admin started."
            else
                echo "Failed to start. Check: shufflectl web logs"
                exit 1
            fi
            ;;
        stop)
            systemctl --user stop "$WEB_SERVICE"
            echo "Web admin stopped."
            ;;
        restart)
            systemctl --user restart "$WEB_SERVICE"
            sleep 1
            if systemctl --user is-active --quiet "$WEB_SERVICE"; then
                echo "Web admin restarted."
            else
                echo "Failed to restart. Check: shufflectl web logs"
                exit 1
            fi
            ;;
        status)
            echo ""
            echo "── Web Admin Status ──"
            systemctl --user status "$WEB_SERVICE" --no-pager 2>/dev/null || echo "  Service not running"
            ;;
        logs)
            journalctl --user -u "$WEB_SERVICE" -f --no-pager
            ;;
        logs-full)
            journalctl --user -u "$WEB_SERVICE" -n 200 --no-pager
            ;;
        update)
            if [ -d "web" ]; then
                echo "Updating web app files..."
                mkdir -p "$HOME/shuffle-web/web"
                cp -r web/* "$HOME/shuffle-web/web/" 2>/dev/null || true
                [ -f "web/requirements.txt" ] && cp web/requirements.txt "$HOME/shuffle-web/requirements.txt"
                [ -f "$HOME/shuffle-web/.env" ] || cp "$HOME/shuffle-web/.env.example" "$HOME/shuffle-web/.env" 2>/dev/null || true
                "$HOME/shuffle-web/venv/bin/pip" install --quiet -r "$HOME/shuffle-web/requirements.txt" 2>/dev/null || true
                if systemctl --user is-active --quiet "$WEB_SERVICE" 2>/dev/null; then
                    systemctl --user restart "$WEB_SERVICE"
                    sleep 1
                    echo "Web admin updated + restarted."
                else
                    echo "Web admin updated. Start with: shufflectl web start"
                fi
            else
                echo "No web/ directory found."
                exit 1
            fi
            ;;
        *)
            echo "Usage: shufflectl web [install|start|stop|restart|status|logs|logs-full|update]"
            ;;
    esac
}

# ── Dispatch ──────────────────────────────────────────
case "${1:-}" in
    setup)        cmd_setup ;;
    start)        cmd_start "${2:-}" ;;
    stop)         cmd_stop "${2:-}" ;;
    restart)      shift; cmd_restart "$@" ;;
    status)       cmd_status ;;
    monitor)      cmd_monitor "${2:-}" ;;
    lanes)        shift; cmd_lanes "$@" ;;
    lane)         shift; cmd_lane "$@" ;;
    key)          shift; cmd_key "$@" ;;
    logs)         cmd_logs ;;
    logs-full)    cmd_logs_full ;;
    interactive)  cmd_interactive ;;
    tmux)         cmd_tmux ;;
    stats)        shift; cmd_stats "$@" ;;
    analytics)    shift; cmd_analytics "$@" ;;
    session)      cmd_session "${2:-}" ;;
    presets)      cmd_presets ;;
    last-bets)    cmd_last_bets "${2:-}" ;;
    export)       cmd_export "${2:-}" "${3:-}" ;;
    backtest)     shift; cmd_backtest "$@" ;;
    preset)       cmd_preset "${2:-}" ;;
    config-show)  cmd_config_show ;;
    config-set)   shift; cmd_config_set "$@" ;;
    cleanup)      cmd_cleanup "${2:-}" ;;
    benchmark)    shift; cmd_benchmark "$@" ;;
    diagnose)     cmd_diagnose ;;
    doctor)       shift; cmd_doctor "$@" ;;
    reset)        shift; cmd_reset "$@" ;;
    run-reset)    shift; cmd_run_reset "$@" ;;
    archives)     cmd_archives ;;
    refresh)      cmd_refresh ;;
    version|--version|-v) cmd_version ;;
    update)       shift; cmd_update "$@" ;;
    start-all)    cmd_start_all ;;
    stop-all)     cmd_stop_all ;;
    status-all)   cmd_status_all ;;
    tg)           cmd_tg "${2:-}" ;;
    web)          cmd_web "${@:2}" ;;
    help|--help|-h) usage ;;
    *)            usage ;;
esac
exit
}
