}

cmd_setup() {
    echo "Running setup wizard..."
    "$PYTHON" "$BOT" --setup-only
}

# ── Parallel lanes ────────────────────────────────────
# Lane ids from the config registry: the enabled ones, or every id with "all" (1 when unreadable).
lane_ids() {
    local ids
    ids=$("$PYTHON" "$BOT" --lane-ids "${1:-enabled}" 2>/dev/null) || ids=""
    echo "${ids:-1}"
}

lane_count() {
    set -- $(lane_ids)
    echo "$#"
}

# True when lane $1 is in the registry (enabled lanes, or every lane with "all").
has_lane() {
    local k
    for k in $(lane_ids "${2:-enabled}"); do
        [ "$k" = "$1" ] && return 0
    done
    return 1
}

# Write the systemd template for lanes 2..N (same unit as lane 1 + --lane %i).
ensure_lane_unit() {
    local unit="$SYSTEMD_DIR/${LANE_SERVICE}@.service"
    [ -f "$unit" ] && grep -q -- '--lane %i' "$unit" && grep -q '^WantedBy=' "$unit" && return 0
    mkdir -p "$SYSTEMD_DIR"
    cat > "$unit" << UNITEOF
[Unit]
Description=Shuffle AutoBot - parallel lane %i (CLI)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=0
WorkingDirectory=${INSTALL_DIR}
ExecStart=${INSTALL_DIR}/venv/bin/python3 ${INSTALL_DIR}/shuffle.py --resume --daemon --lane %i
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

KillSignal=SIGTERM
TimeoutStopSec=15

Environment=HOME=${HOME}
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
UNITEOF
    systemctl --user daemon-reload
}

# Start and boot-enable every enabled lane 2+; stop and disable the disabled ones.
# With --no-start the enabled lanes are only boot-enabled (bot stopped).
sync_lanes() {
    local k enabled now="--now"
    [ "${1:-}" = "--no-start" ] && now=""
    enabled=" $(lane_ids) "
    [ "$enabled" = " 1 " ] || ensure_lane_unit
    for k in $(lane_ids all); do
        [ "$k" -gt 1 ] || continue
        case "$enabled" in
            *" $k "*) systemctl --user enable $now "${LANE_SERVICE}@${k}" >/dev/null 2>&1 || true ;;
            *)
                if systemctl --user is-enabled --quiet "${LANE_SERVICE}@${k}" 2>/dev/null \
                        || systemctl --user is-active --quiet "${LANE_SERVICE}@${k}" 2>/dev/null; then
                    systemctl --user disable --now "${LANE_SERVICE}@${k}" >/dev/null 2>&1 || true
                    echo "  lane $k stopped"
                fi ;;
        esac
    done
}

# Stop the lanes in $1 that are not in $2 and start the ones that are new; the rest keep running.
apply_lane_delta() {
    local before=" $1 " after=" $2 " k
    for k in $1; do
        [ "$k" -gt 1 ] || continue
        case "$after" in
            *" $k "*) ;;
            *) systemctl --user disable --now "${LANE_SERVICE}@${k}" >/dev/null 2>&1 || true
               echo "  lane $k stopped" ;;
        esac
    done
    for k in $2; do
        case "$before" in *" $k "*) continue ;; esac
        if systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; then
            ensure_lane_unit
            systemctl --user enable --now "${LANE_SERVICE}@${k}" >/dev/null 2>&1 || true
            echo "  lane $k started"
        else
            echo "  lane $k ready; start it with: shufflectl start $k"
        fi
    done
}

stop_all_lanes() {
    local k
    for k in $(lane_ids all); do
        [ "$k" -gt 1 ] || continue
        systemctl --user stop "${LANE_SERVICE}@${k}" 2>/dev/null || true
    done
}

# The systemd unit of lane K: lane 1 is the main service, lanes 2+ the lane template.
lane_unit() {
    if [ "$1" -eq 1 ]; then echo "$SERVICE"; else echo "${LANE_SERVICE}@$1"; fi
}

# Start, stop or restart one enabled lane alone; every other lane keeps betting.
cmd_lane_unit() {
    local verb=$1 k=$2 unit state
    case "$k" in ''|*[!0-9]*) echo "Usage: shufflectl $verb [K]  (K = a lane id from 'shufflectl lanes')" >&2; exit 2 ;; esac
    k=$((10#$k))
    if ! has_lane "$k"; then
        echo "No lane $k: this bot runs $(lane_count) lane(s)." >&2; exit 2
    fi
    if [ "$verb" != stop ] && [ ! -f "$CONFIG" ]; then
        echo "No config found. Run 'shufflectl setup' first." >&2; exit 1
    fi
    unit=$(lane_unit "$k")
    [ "$k" -eq 1 ] || ensure_lane_unit
    systemctl --user "$verb" "$unit" 2>/dev/null || true
    [ "$verb" = stop ] || sleep 1
    state=$(systemctl --user is-active "$unit" 2>/dev/null || true)
    if [ -z "$state" ]; then
        echo "Cannot reach the user's systemd to check $unit (is XDG_RUNTIME_DIR set?)." >&2; exit 1
    fi
    case "$verb" in
        start)
            [ "$state" = active ] || { echo "Lane $k did not start ($state)." >&2; exit 1; }
            echo "Lane $k started." ;;
        restart)
            [ "$state" = active ] || { echo "Lane $k did not start ($state)." >&2; exit 1; }
            echo "Lane $k restarted. Other lanes keep betting." ;;
        *)
            case "$state" in inactive|failed) ;; *) echo "Lane $k is still $state." >&2; exit 1 ;; esac
            echo "Lane $k stopped. Other lanes keep betting." ;;
    esac
}

lane_split_mode() {
    "$PYTHON" - "$CONFIG" <<'PY' 2>/dev/null || echo none
import json, sys
try:
    print((json.load(open(sys.argv[1])).get("lanes") or {}).get("split") or "none")
except Exception:
    print("none")
PY
}

cmd_lanes() {
    local n="" split="" max="" before out
    local pairs=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --split) split="${2:-}"; shift 2 || { echo "Usage: shufflectl lanes N --split none|budget|bet|both"; exit 1; } ;;
            --split=*) split="${1#--split=}"; shift ;;
            --max) max="${2:-}"; shift 2 || { echo "Usage: shufflectl lanes --max N  (1-$LANE_ID_MAX)"; exit 1; } ;;
            --max=*) max="${1#--max=}"; shift ;;
            -*) echo "Unknown option: $1"; exit 1 ;;
            *) [ -z "$n" ] || { echo "Unknown option: $1"; exit 1; }; n="$1"; shift ;;
        esac
    done
    if [ -z "$n" ] && [ -n "$split" ]; then
        echo "Usage: shufflectl lanes N --split none|budget|bet|both"; exit 1
    fi
    if [ -n "$split" ]; then
        case "$split" in none|budget|bet|both) ;; *) echo "--split must be none, budget, bet or both"; exit 1 ;; esac
    fi
    if [ -n "$max" ]; then
        case "$max" in ''|*[!0-9]*) echo "Usage: shufflectl lanes --max N  (1-$LANE_ID_MAX)"; exit 1 ;; esac
        pairs+=("lanes_max=$max")
    fi
    if [ -z "$n" ] && [ -z "$max" ]; then
        echo "Configured lanes: $(lane_count)"
        "$PYTHON" "$BOT" --lanes-status 2>/dev/null || true
        echo "  Split: $(lane_split_mode)"
        echo "  Change with: shufflectl lanes N [--split none|budget|bet|both] [--max N]"
        return
    fi
    if [ -n "$n" ]; then
        case "$n" in *[!0-9]*) echo "Usage: shufflectl lanes N"; exit 1 ;; esac
        pairs+=("lanes=$n")
    fi
    [ -z "$split" ] || pairs+=("lane_split=$split")
    before=$(lane_ids)
    if ! out=$("$PYTHON" "$BOT" --config-set "${pairs[@]}" 2>&1); then
        echo "$out" >&2
        exit 2
    fi
    [ -z "$max" ] || echo "Lane limit set to $max."
    [ -n "$n" ] || return 0
    echo "Lanes set to $n - split: $(lane_split_mode)."
    apply_lane_delta "$before" "$(lane_ids)"
    if [ "$before" != "$(lane_ids)" ]; then
        case "$(lane_split_mode)" in
            budget|both) echo "Budget shares update when each lane restarts: shufflectl restart K." ;;
        esac
    fi
    "$PYTHON" "$BOT" --lanes-status 2>/dev/null || true
}

# Read one secret without echo; the caller pipes it to the bot's stdin, never into argv.
read_secret() {
    local secret=""
    if [ -t 0 ]; then
        read -rs -p "$1: " secret || true
        echo >&2
    else
        IFS= read -r secret || true
    fi
    printf '%s\n' "$secret"
}

cmd_key() {
    local sub="${1:-}" id="" label="" kind="key" secret prompt
    local usage_line="Usage: shufflectl key list | add ID [--label L] [--kind key|proxy|telegram] | rotate ID | delete ID"
    [ $# -gt 0 ] && shift
    case "$sub" in
        list)
            [ $# -eq 0 ] || { echo "$usage_line" >&2; exit 2; }
            "$PYTHON" "$BOT" --key-list
            ;;
        add|rotate)
            id="${1:-}"
            [ -n "$id" ] || { echo "$usage_line" >&2; exit 2; }
            shift
            while [ $# -gt 0 ]; do
                [ "$sub" = add ] || { echo "$usage_line" >&2; exit 2; }
                case "$1" in
                    --label) label="${2:-}"; shift 2 || { echo "$usage_line" >&2; exit 2; } ;;
                    --kind) kind="${2:-}"; shift 2 || { echo "$usage_line" >&2; exit 2; } ;;
                    *) echo "$usage_line" >&2; exit 2 ;;
                esac
            done
            case "$kind" in
                key) prompt="Paste the token for $id (hidden)" ;;
                proxy) prompt="Paste the proxy URL for $id (hidden)" ;;
                telegram) prompt="Paste the Telegram bot token (hidden)" ;;
                *) echo "$usage_line" >&2; exit 2 ;;
            esac
            secret=$(read_secret "$prompt")
            if [ "$sub" = add ]; then
                printf '%s\n' "$secret" | "$PYTHON" "$BOT" --key-put "$id" --key-kind "$kind" \
                    ${label:+--key-label "$label"} || exit $?
            else
                printf '%s\n' "$secret" | "$PYTHON" "$BOT" --key-rotate "$id" || exit $?
            fi
            ;;
        delete)
            [ $# -eq 1 ] || { echo "$usage_line" >&2; exit 2; }
            "$PYTHON" "$BOT" --key-delete "$1" || exit $?
            ;;
        *)
            echo "$usage_line" >&2
            exit 2
            ;;
    esac
}

# A removed lane's state, pid, run and session-end files, once its unit is stopped; its
# history stays in the database.
forget_lane_files() {
    local k=$1
    [ "$k" -gt 1 ] || return 0
    rm -f "$HOME/.shuffle_autobot_live.lane$k.json" "$HOME/.shuffle_autobot.lane$k.pid" \
          "$HOME/.shuffle_run.lane$k.json" "$HOME/.shuffle_autobot.lane$k.drain"
}

# Add, remove or rename one lane; every other lane keeps betting.
cmd_lane() {
    local sub="${1:-}" name="" from="" k before
    [ $# -gt 0 ] && shift
    case "$sub" in
        add)
            while [ $# -gt 0 ]; do
                case "$1" in
                    --from) from="${2:-}"; shift 2 || { echo "Usage: shufflectl lane add NAME [--from K]" >&2; exit 2; } ;;
                    --from=*) from="${1#--from=}"; shift ;;
                    -*) echo "Unknown option: $1" >&2; exit 2 ;;
                    *) [ -z "$name" ] || { echo "Usage: shufflectl lane add NAME [--from K]" >&2; exit 2; }; name="$1"; shift ;;
                esac
            done
            [ -n "$name" ] || { echo "Usage: shufflectl lane add NAME [--from K]" >&2; exit 2; }
            if [ -n "$from" ]; then
                case "$from" in *[!0-9]*) echo "Usage: shufflectl lane add NAME [--from K]" >&2; exit 2 ;; esac
            fi
            before=$(lane_ids)
            "$PYTHON" "$BOT" --lane-add "$name" ${from:+--lane-from "$((10#$from))"} || exit $?
            apply_lane_delta "$before" "$(lane_ids)"
            echo "Other lanes keep betting."
            ;;
        remove)
            k="${1:-}"
            case "$k" in ''|*[!0-9]*) echo "Usage: shufflectl lane remove K [--after-session]" >&2; exit 2 ;; esac
            if [ "${2:-}" = "--after-session" ] && [ $# -eq 2 ]; then
                k=$((10#$k))
                if [ "$k" -le 1 ] || systemctl --user is-active --quiet "$(lane_unit "$k")" 2>/dev/null; then
                    "$PYTHON" "$BOT" --lane-drain "$k" remove
                    exit $?
                fi
                # A stopped lane never reaches its session end, so the request would wait forever.
                echo "Lane $k is not running, so it is removed now."
                set -- "$k"
            fi
            [ $# -eq 1 ] || { echo "Usage: shufflectl lane remove K [--after-session]" >&2; exit 2; }
            k=$((10#$k))
            "$PYTHON" "$BOT" --lane-remove "$k" || exit $?
            systemctl --user disable --now "${LANE_SERVICE}@${k}" >/dev/null 2>&1 || true
            case "$(systemctl --user is-active "${LANE_SERVICE}@${k}" 2>/dev/null || true)" in
                active|activating|deactivating) echo "Lane $k is still running." >&2; exit 1 ;;
            esac
            forget_lane_files "$k"
            echo "Lane $k stopped. Other lanes keep betting."
            ;;
        rename)
            k="${1:-}" name="${2:-}"
            case "$k" in ''|*[!0-9]*) echo "Usage: shufflectl lane rename K NAME" >&2; exit 2 ;; esac
            [ $# -eq 2 ] || { echo "Usage: shufflectl lane rename K NAME" >&2; exit 2; }
            k=$((10#$k))
            has_lane "$k" all || { echo "No lane $k." >&2; exit 2; }
            "$PYTHON" "$BOT" --config-set "lane${k}.name=$name"
            ;;
        *)
            echo "Usage: shufflectl lane add NAME [--from K] | remove K [--after-session] | rename K NAME" >&2
            exit 2
            ;;
    esac
}

cmd_start() {
    if [ -n "${1:-}" ]; then cmd_lane_unit start "$1"; return; fi
    if [ ! -f "$CONFIG" ]; then
        echo "No config found. Run 'shufflectl setup' first."
        exit 1
    fi
    local was_active=0
    if systemctl --user is-active --quiet "$SERVICE"; then
        was_active=1
    fi
    systemctl --user start "$SERVICE"
    sleep 1
    if systemctl --user is-active --quiet "$SERVICE"; then
        local n
        n=$(lane_count)
        sync_lanes
        if [ "$was_active" -eq 1 ]; then
            echo "CLI bot was already running - nothing restarted."
            echo "  Apply a saved config:  shufflectl restart"
        elif [ "$n" -gt 1 ]; then
            echo "Bot started with $n lanes."
        else
            echo "Bot started successfully."
        fi
        echo "  Check status:  shufflectl status"
        echo "  View logs:     shufflectl logs"
    else
        echo "Failed to start. Check logs: shufflectl logs-full"
        exit 1
    fi
}

cmd_stop() {
    if [ -n "${1:-}" ]; then cmd_lane_unit stop "$1"; return; fi
    stop_all_lanes
    systemctl --user stop "$SERVICE"
    echo "Bot stopped."
    "$PYTHON" "$BOT" --status 2>/dev/null || true
}

cmd_restart() {
    case "${2:-}" in
        --at-boundary|--cancel-boundary)
            case "${1:-}" in ''|*[!0-9]*) echo "Usage: shufflectl restart K [--at-boundary|--cancel-boundary]" >&2; exit 2 ;; esac
            [ $# -eq 2 ] || { echo "Usage: shufflectl restart K [--at-boundary|--cancel-boundary]" >&2; exit 2; }
            local action=restart
            [ "$2" = "--cancel-boundary" ] && action=cancel
            if [ "$action" = restart ] && has_lane "$((10#$1))" \
                    && ! systemctl --user is-active --quiet "$(lane_unit "$((10#$1))")" 2>/dev/null; then
                echo "Lane $((10#$1)) is stopped; start it with: shufflectl start $((10#$1))" >&2
                exit 1
            fi
            "$PYTHON" "$BOT" --lane-drain "$((10#$1))" "$action"
            return $?
            ;;
        '') ;;
        *) echo "Usage: shufflectl restart K [--at-boundary|--cancel-boundary]" >&2; exit 2 ;;
    esac
    if [ -n "${1:-}" ]; then cmd_lane_unit restart "$1"; return; fi
    stop_all_lanes
    systemctl --user restart "$SERVICE"
    sleep 1
    sync_lanes
    echo "Bot restarted."
    "$PYTHON" "$BOT" --status 2>/dev/null || true
}

cmd_status() {
    echo ""
    echo "── Service Status ──"
    systemctl --user status "$SERVICE" --no-pager 2>/dev/null || echo "  Service not running"
    echo ""
    echo "── Session Status ──"
    "$PYTHON" "$BOT" --status 2>/dev/null || echo "  No active session"
    if [ "$(lane_count)" -gt 1 ]; then
        echo ""
        "$PYTHON" "$BOT" --lanes-status 2>/dev/null || true
    fi
}

cmd_logs() {
    journalctl --user -u "$SERVICE" -f --no-pager
}

cmd_logs_full() {
    journalctl --user -u "$SERVICE" -n 200 --no-pager
}

cmd_monitor() {
    local k="${1:-1}"
    case "$k" in ''|*[!0-9]*) k=1 ;; esac
    "$PYTHON" "$BOT" --monitor --lane "$k"
}

cmd_interactive() {
    if [ ! -f "$CONFIG" ]; then
        echo "No config found. Run 'shufflectl setup' first."
        exit 1
    fi
    if ! systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; then
        systemctl --user start "$SERVICE"
        sleep 1
        if ! systemctl --user is-active --quiet "$SERVICE"; then
            echo "Failed to start daemon. Check: shufflectl logs-full"
            exit 1
        fi
        echo "Daemon started."
    fi
    "$PYTHON" "$BOT" --monitor
}

cmd_tmux() {
    SESSION="shuffle"
    if ! systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; then
        if [ ! -f "$CONFIG" ]; then
            echo "No config found. Run 'shufflectl setup' first."
            exit 1
        fi
        systemctl --user start "$SERVICE"
        sleep 1
    fi
    if tmux has-session -t "$SESSION" 2>/dev/null; then
        echo "tmux session '$SESSION' already running."
        echo "  Attach:  tmux attach -t $SESSION"
    else
        tmux new-session -d -s "$SESSION" "$PYTHON $BOT --monitor"
        echo "Started monitor in tmux session '$SESSION'"
        echo "  Attach:  tmux attach -t $SESSION"
        echo "  Detach:  Ctrl+B then D"
    fi
}

cmd_stats() {
    "$PYTHON" "$BOT" --stats "$@"
}

cmd_analytics() {
    "$PYTHON" "$BOT" --analytics "$@"
}

cmd_session() {
    local sid="${1:-}"
    if [ -z "$sid" ]; then
        echo "Usage: shufflectl session <ID>"
        echo "  Get full stats for a specific session (streaks, distribution, bets)"
        exit 1
    fi
    "$PYTHON" "$BOT" --session-bets "$sid"
}

cmd_presets() {
    "$PYTHON" "$BOT" --list-presets
}

