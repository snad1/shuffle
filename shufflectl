#!/usr/bin/env bash
# Shuffle AutoBot: Management Command v1.5
# Wrapped in { } so bash reads entire script before executing -
# prevents corruption when cmd_update replaces this file mid-run.
{
set -euo pipefail

INSTALL_DIR="$HOME/shuffle-bot"
WEB_DIR="$HOME/shuffle-web"
SERVICE="shuffle"
TG_SERVICE="shuffle-tg"
WEB_SERVICE="shuffle-web"
# Parallel lanes: lane 1 = $SERVICE, every other lane id K = shuffle-lane@K
LANE_SERVICE="shuffle-lane"
LANE_ID_MAX=99
SYSTEMD_DIR="$HOME/.config/systemd/user"
PYTHON="$INSTALL_DIR/venv/bin/python3"
BOT="$INSTALL_DIR/shuffle.py"
TG_ENV="$HOME/.shuffle_tg_env"
CONFIG="$HOME/.shuffle_autobot.json"
DB="$HOME/.shuffle_autobot.db"
SCRIPT_NAME="shufflectl"
# Grep-parsed by update / refresh / doctor to spot an installed copy older
# than the repo copy: keep the format `SHUFFLECTL_VERSION=X.Y`.
SHUFFLECTL_VERSION=1.5

usage() {
    echo ""
    echo "  shufflectl: Shuffle AutoBot Manager v$SHUFFLECTL_VERSION"
    echo ""
    echo "  SETUP:"
    echo "    shufflectl setup       Run wizard to configure (saves config, doesn't start)"
    echo ""
    echo "  RUNNING:"
    echo "    shufflectl start [K]   Start the bot as a daemon (every lane, or lane K alone)"
    echo "    shufflectl stop [K]    Stop the bot (every lane, or lane K alone)"
    echo "    shufflectl restart [K] Restart the bot (every lane, or lane K alone)"
    echo "    shufflectl restart K --at-boundary | --cancel-boundary   Restart lane K when its session ends"
    echo "    shufflectl lanes [N] [--split none|budget|bet|both] [--max N]   Show or set parallel lanes"
    echo "    shufflectl lane add NAME [--from K] | remove K [--after-session] | rename K NAME   Change one lane; the others keep betting"
    echo "    shufflectl preset NAME Load a named preset and start as a daemon"
    echo ""
    echo "  MONITORING:"
    echo "    shufflectl monitor [K] Attach live TUI to running daemon, lane K (Q=detach, S=stop)"
    echo "    shufflectl status      Show bot status snapshot (non-interactive)"
    echo "    shufflectl logs        Stream live logs"
    echo "    shufflectl logs-full   Show last 200 log lines"
    echo "    shufflectl diagnose    Bottleneck analysis of the running session"
    echo "    shufflectl benchmark [N] [--lanes M]  Time N probe requests"
    echo "    shufflectl doctor [--fix] [--yes]     Health check; --fix applies safe fixes"
    echo ""
    echo "  BATCH:"
    echo "    shufflectl start-all   Start CLI Bot + Telegram Bot + Web Admin"
    echo "    shufflectl stop-all    Stop  CLI Bot + Telegram Bot + Web Admin"
    echo "    shufflectl status-all  Show status of all three services"
    echo ""
    echo "  SHORTCUTS:"
    echo "    shufflectl interactive Start daemon + attach monitor in one command"
    echo "    shufflectl tmux        Run monitor in a detachable tmux session"
    echo ""
    echo "  CONFIG:"
    echo "    shufflectl config-show Print the saved config (secrets masked)"
    echo "    shufflectl key list | add ID [--label L] [--kind key|proxy|telegram] | rotate ID | delete ID"
    echo "                          Vault tokens, proxies and the Telegram token (hidden prompt)"
    echo "    shufflectl config-set KEY=VALUE ...  Change saved keys; a running daemon reloads"
    echo ""
    echo "  DATA:"
    echo "    shufflectl stats [--since DATE] [--until DATE] [--lane K]      Session stats (optional window / lane)"
    echo "    shufflectl analytics [--since DATE] [--until DATE] [--lane K]  Aggregates: by game, strategy, lane, top 5"
    echo "    shufflectl session ID  Full stats + streak distribution for a session"
    echo "    shufflectl last-bets [N]  Last N bets across all sessions (default 20)"
    echo "    shufflectl presets     List saved presets"
    echo "    shufflectl export PATH [SID]  Export a session (CSV, or JSON by .json extension)"
    echo "    shufflectl backtest [args]    Backtest / replay offline (no API calls, no real balance)"
    echo "    shufflectl cleanup [DAYS]     Purge bet rows of old sessions (default: purge_days)"
    echo "    shufflectl reset [--yes]      Archive the stats DB and start fresh (never deletes)"
    echo "    shufflectl archives    List archived stats DBs"
    echo "    shufflectl run-reset [--yes]  New run total for the run-wide profit increment"
    echo ""
    echo "  MAINTENANCE:"
    echo "    shufflectl update      Pull and reinstall; each lane restarts on the new code at its session end"
    echo "    shufflectl update --critical   Same, but restart every lane now"
    echo "    shufflectl refresh     Reinstall shufflectl from the repo copy in this folder"
    echo "    shufflectl version     Bot and shufflectl versions"
    echo ""
    echo "  TELEGRAM BOT:"
    echo "    shufflectl tg setup    Set Telegram bot token"
    echo "    shufflectl tg start    Start Telegram bot service"
    echo "    shufflectl tg stop     Stop Telegram bot service"
    echo "    shufflectl tg restart  Restart Telegram bot service"
    echo "    shufflectl tg status   Show Telegram bot status"
    echo "    shufflectl tg logs     Stream Telegram bot logs"
    echo "    shufflectl tg logs-full Show last 200 TG bot log lines"
    echo ""
    echo "  WEB ADMIN:"
    echo "    shufflectl web install  Install web admin dashboard"
    echo "    shufflectl web start    Start web app"
    echo "    shufflectl web stop     Stop web app"
    echo "    shufflectl web restart  Restart web app"
    echo "    shufflectl web status   Show web app status"
    echo "    shufflectl web logs     Stream web app logs"
    echo "    shufflectl web update   Update web app files"
