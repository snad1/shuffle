#!/usr/bin/env bash
# Shuffle AutoBot — Management Command v1.0
set -euo pipefail

INSTALL_DIR="$HOME/shuffle-bot"
SERVICE="shuffle"
TG_SERVICE="shuffle-tg"
WEB_SERVICE="shuffle-web"
PYTHON="$INSTALL_DIR/venv/bin/python3"
BOT="$INSTALL_DIR/shuffle.py"
TG_ENV="$HOME/.shuffle_tg_env"
SCRIPT_NAME="shufflectl"

usage() {
    echo ""
    echo "  shufflectl — Shuffle AutoBot Manager v1.0"
    echo ""
    echo "  SETUP:"
    echo "    shufflectl setup       Run wizard to configure (saves config, doesn't start)"
    echo ""
    echo "  RUNNING:"
    echo "    shufflectl start       Start bot as background daemon"
    echo "    shufflectl stop        Stop the bot"
    echo "    shufflectl restart     Restart the bot"
    echo ""
    echo "  MONITORING:"
    echo "    shufflectl monitor     Attach live TUI to running daemon (Q=detach, S=stop)"
    echo "    shufflectl status      Show bot status snapshot (non-interactive)"
    echo "    shufflectl logs        Stream live logs"
    echo "    shufflectl logs-full   Show last 200 log lines"
    echo ""
    echo "  SHORTCUTS:"
    echo "    shufflectl interactive Start daemon + attach monitor in one command"
    echo "    shufflectl tmux        Run monitor in a detachable tmux session"
    echo ""
    echo "  DATA:"
    echo "    shufflectl stats       Show all-time session statistics"
    echo "    shufflectl session ID  Full stats + streak distribution for a session"
    echo "    shufflectl presets     List saved presets"
    echo "    shufflectl update      Update bot from current directory"
    echo ""
    echo "  TELEGRAM BOT:"
    echo "    shufflectl tg setup    Set Telegram bot token"
    echo "    shufflectl tg start    Start Telegram bot service"
    echo "    shufflectl tg stop     Stop Telegram bot service"
    echo "    shufflectl tg restart  Restart Telegram bot service"
    echo "    shufflectl tg status   Show Telegram bot status"
    echo "    shufflectl tg logs     Stream Telegram bot logs"
    echo "    shufflectl tg logs-full Show last 200 TG bot log lines"
    echo ""
    echo "  WEB ADMIN:"
    echo "    shufflectl web install  Install web admin dashboard"
    echo "    shufflectl web start    Start web app"
    echo "    shufflectl web stop     Stop web app"
    echo "    shufflectl web restart  Restart web app"
    echo "    shufflectl web status   Show web app status"
    echo "    shufflectl web logs     Stream web app logs"
    echo "    shufflectl web update   Update web app files"
    echo ""
}

cmd_setup() {
    echo "Running setup wizard…"
    "$PYTHON" "$BOT" --setup-only
}

cmd_start() {
    if [ ! -f "$HOME/.shuffle_autobot.json" ]; then
        echo "No config found. Run 'shufflectl setup' first."
        exit 1
    fi
    systemctl --user start "$SERVICE"
    sleep 1
    if systemctl --user is-active --quiet "$SERVICE"; then
        echo "Bot started successfully."
        echo "  Check status:  shufflectl status"
        echo "  View logs:     shufflectl logs"
    else
        echo "Failed to start. Check logs: shufflectl logs-full"
        exit 1
    fi
}

cmd_stop() {
    systemctl --user stop "$SERVICE"
    echo "Bot stopped."
    "$PYTHON" "$BOT" --status 2>/dev/null || true
}

cmd_restart() {
    systemctl --user restart "$SERVICE"
    sleep 1
    echo "Bot restarted."
    "$PYTHON" "$BOT" --status 2>/dev/null || true
}

cmd_status() {
    echo ""
    echo "── Service Status ──"
    systemctl --user status "$SERVICE" --no-pager 2>/dev/null || echo "  Service not running"
    echo ""
    echo "── Session Status ──"
    "$PYTHON" "$BOT" --status 2>/dev/null || echo "  No active session"
}

cmd_logs() {
    journalctl --user -u "$SERVICE" -f --no-pager
}

cmd_logs_full() {
    journalctl --user -u "$SERVICE" -n 200 --no-pager
}

cmd_monitor() {
    "$PYTHON" "$BOT" --monitor
}

cmd_interactive() {
    if [ ! -f "$HOME/.shuffle_autobot.json" ]; then
        echo "No config found. Run 'shufflectl setup' first."
        exit 1
    fi
    if ! systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; then
        systemctl --user start "$SERVICE"
        sleep 1
        if ! systemctl --user is-active --quiet "$SERVICE"; then
            echo "Failed to start daemon. Check: shufflectl logs-full"
            exit 1
        fi
        echo "Daemon started."
    fi
    "$PYTHON" "$BOT" --monitor
}

cmd_tmux() {
    SESSION="shuffle"
    if ! systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; then
        if [ ! -f "$HOME/.shuffle_autobot.json" ]; then
            echo "No config found. Run 'shufflectl setup' first."
            exit 1
        fi
        systemctl --user start "$SERVICE"
        sleep 1
    fi
    if tmux has-session -t "$SESSION" 2>/dev/null; then
        echo "tmux session '$SESSION' already running."
        echo "  Attach:  tmux attach -t $SESSION"
    else
        tmux new-session -d -s "$SESSION" "$PYTHON $BOT --monitor"
        echo "Started monitor in tmux session '$SESSION'"
        echo "  Attach:  tmux attach -t $SESSION"
        echo "  Detach:  Ctrl+B then D"
    fi
}

cmd_stats() {
    "$PYTHON" "$BOT" --stats
}

cmd_session() {
    local sid="${1:-}"
    if [ -z "$sid" ]; then
        echo "Usage: shufflectl session <ID>"
        echo "  Get full stats for a specific session (streaks, distribution, bets)"
        exit 1
    fi
    "$PYTHON" "$BOT" --session-bets "$sid"
}

cmd_presets() {
    "$PYTHON" "$BOT" --list-presets
}

cmd_update() {
    if git rev-parse --is-inside-work-tree &>/dev/null; then
        echo "Pulling latest from git…"
        git pull --ff-only || { echo "Git pull failed. Resolve manually."; exit 1; }
    fi
    if [ ! -f "shuffle.py" ]; then
        echo "No shuffle.py in current directory."
        exit 1
    fi

    cp shuffle.py "$INSTALL_DIR/shuffle.py"
    cp requirements.txt "$INSTALL_DIR/" 2>/dev/null
    [ -f ".env.example" ] && cp .env.example "$INSTALL_DIR/"

    "$INSTALL_DIR/venv/bin/pip" install --quiet -r "$INSTALL_DIR/requirements.txt" 2>/dev/null || true

    if [ -d "core" ]; then
        mkdir -p "$INSTALL_DIR/core"
        cp core/*.py "$INSTALL_DIR/core/"
    fi
    if [ -d "tg" ]; then
        mkdir -p "$INSTALL_DIR/tg"
        cp tg/*.py "$INSTALL_DIR/tg/"
    fi

    # Self-update
    if [ -f "$SCRIPT_NAME" ]; then
        local installed
        installed="$(command -v "$SCRIPT_NAME" 2>/dev/null || true)"
        if [ -n "$installed" ] && [ -f "$installed" ]; then
            cp "$SCRIPT_NAME" "$installed"
            chmod +x "$installed"
            echo "Updated $SCRIPT_NAME → $installed"
        fi
    fi

    # Update web app if installed
    if [ -d "$HOME/shuffle-web" ] && [ -d "web" ]; then
        mkdir -p "$HOME/shuffle-web/web"
        cp -r web/* "$HOME/shuffle-web/web/" 2>/dev/null || true
        [ -f "web/requirements.txt" ] && cp web/requirements.txt "$HOME/shuffle-web/requirements.txt"
        "$HOME/shuffle-web/venv/bin/pip" install --quiet -r "$HOME/shuffle-web/requirements.txt" 2>/dev/null || true
        if systemctl --user is-active --quiet "$WEB_SERVICE" 2>/dev/null; then
            systemctl --user restart "$WEB_SERVICE"
            echo "Web admin updated + restarted."
        fi
    fi

    # Auto-restart TG bot if running
    if systemctl --user is-active --quiet "$TG_SERVICE" 2>/dev/null; then
        systemctl --user restart "$TG_SERVICE"
        sleep 1
        if systemctl --user is-active --quiet "$TG_SERVICE"; then
            echo "Updated + Telegram bot restarted."
        else
            echo "Updated but TG restart failed. Check: shufflectl tg logs"
        fi
    else
        echo "Updated. TG bot not running (skipped restart)."
    fi
    echo "  CLI bot: shufflectl restart"
}

cmd_tg() {
    local action="${1:-}"
    case "$action" in
        setup)
            echo "Enter your Telegram bot token (from @BotFather):"
            read -r token
            if [ -z "$token" ]; then
                echo "No token provided."
                exit 1
            fi
            echo "SHUFFLE_TG_TOKEN=$token" > "$TG_ENV"
            chmod 600 "$TG_ENV"
            echo "Token saved to $TG_ENV"
            echo "Start with: shufflectl tg start"
            ;;
        start)
            if [ ! -f "$TG_ENV" ]; then
                echo "No TG token configured. Run 'shufflectl tg setup' first."
                exit 1
            fi
            systemctl --user start "$TG_SERVICE"
            sleep 1
            if systemctl --user is-active --quiet "$TG_SERVICE"; then
                echo "Telegram bot started."
                echo "  Check status:  shufflectl tg status"
                echo "  View logs:     shufflectl tg logs"
            else
                echo "Failed to start. Check logs: shufflectl tg logs-full"
                exit 1
            fi
            ;;
        stop)
            systemctl --user stop "$TG_SERVICE"
            echo "Telegram bot stopped."
            ;;
        restart)
            systemctl --user restart "$TG_SERVICE"
            sleep 1
            if systemctl --user is-active --quiet "$TG_SERVICE"; then
                echo "Telegram bot restarted."
            else
                echo "Failed to restart. Check: shufflectl tg logs-full"
            fi
            ;;
        status)
            echo ""
            echo "── Telegram Bot Status ──"
            systemctl --user status "$TG_SERVICE" --no-pager 2>/dev/null || echo "  Service not running"
            ;;
        logs)
            journalctl --user -u "$TG_SERVICE" -f --no-pager
            ;;
        logs-full)
            journalctl --user -u "$TG_SERVICE" -n 200 --no-pager
            ;;
        env)
            ENV_FILE="$INSTALL_DIR/.env"
            if [ ! -f "$ENV_FILE" ]; then
                if [ -f "$INSTALL_DIR/.env.example" ]; then
                    cp "$INSTALL_DIR/.env.example" "$ENV_FILE"
                else
                    echo "# Shuffle AutoBot — Environment" > "$ENV_FILE"
                    echo "SHUFFLE_TG_TOKEN=" >> "$ENV_FILE"
                fi
            fi
            ${EDITOR:-nano} "$ENV_FILE"
            TOKEN=$(grep -E "^SHUFFLE_TG_TOKEN=" "$ENV_FILE" | cut -d= -f2- | tr -d ' ')
            if [ -n "$TOKEN" ]; then
                echo "SHUFFLE_TG_TOKEN=$TOKEN" > "$TG_ENV"
                chmod 600 "$TG_ENV"
                echo "Token synced to $TG_ENV"
            fi
            ;;
        *)
            echo "Usage: shufflectl tg [setup|start|stop|restart|status|logs|logs-full|env]"
            ;;
    esac
}

cmd_web() {
    local action="${1:-status}"
    case "$action" in
        install)
            if [ -f "web/install.sh" ]; then
                bash web/install.sh --repo "$(pwd)" "${@:2}"
            else
                echo "web/install.sh not found. Run from the repo directory."
                exit 1
            fi
            ;;
        start)
            systemctl --user start "$WEB_SERVICE"
            sleep 1
            if systemctl --user is-active --quiet "$WEB_SERVICE"; then
                echo "Web admin started."
            else
                echo "Failed to start. Check: shufflectl web logs"
                exit 1
            fi
            ;;
        stop)
            systemctl --user stop "$WEB_SERVICE"
            echo "Web admin stopped."
            ;;
        restart)
            systemctl --user restart "$WEB_SERVICE"
            sleep 1
            if systemctl --user is-active --quiet "$WEB_SERVICE"; then
                echo "Web admin restarted."
            else
                echo "Failed to restart. Check: shufflectl web logs"
                exit 1
            fi
            ;;
        status)
            echo ""
            echo "── Web Admin Status ──"
            systemctl --user status "$WEB_SERVICE" --no-pager 2>/dev/null || echo "  Service not running"
            ;;
        logs)
            journalctl --user -u "$WEB_SERVICE" -f --no-pager
            ;;
        logs-full)
            journalctl --user -u "$WEB_SERVICE" -n 200 --no-pager
            ;;
        update)
            if [ -d "web" ]; then
                echo "Updating web app files…"
                mkdir -p "$HOME/shuffle-web/web"
                cp -r web/* "$HOME/shuffle-web/web/" 2>/dev/null || true
                [ -f "web/requirements.txt" ] && cp web/requirements.txt "$HOME/shuffle-web/requirements.txt"
                [ -f "$HOME/shuffle-web/.env" ] || cp "$HOME/shuffle-web/.env.example" "$HOME/shuffle-web/.env" 2>/dev/null || true
                "$HOME/shuffle-web/venv/bin/pip" install --quiet -r "$HOME/shuffle-web/requirements.txt" 2>/dev/null || true
                if systemctl --user is-active --quiet "$WEB_SERVICE" 2>/dev/null; then
                    systemctl --user restart "$WEB_SERVICE"
                    sleep 1
                    echo "Web admin updated + restarted."
                else
                    echo "Web admin updated. Start with: shufflectl web start"
                fi
            else
                echo "No web/ directory found."
                exit 1
            fi
            ;;
        *)
            echo "Usage: shufflectl web [install|start|stop|restart|status|logs|logs-full|update]"
            ;;
    esac
}

# ── Dispatch ──────────────────────────────────────────
case "${1:-}" in
    setup)        cmd_setup ;;
    start)        cmd_start ;;
    stop)         cmd_stop ;;
    restart)      cmd_restart ;;
    status)       cmd_status ;;
    monitor)      cmd_monitor ;;
    logs)         cmd_logs ;;
    logs-full)    cmd_logs_full ;;
    interactive)  cmd_interactive ;;
    tmux)         cmd_tmux ;;
    stats)        cmd_stats ;;
    session)      cmd_session "${2:-}" ;;
    presets)      cmd_presets ;;
    update)       cmd_update ;;
    tg)           cmd_tg "${2:-}" ;;
    web)          cmd_web "${@:2}" ;;
    *)            usage ;;
esac
